generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookmarks    Bookmark[]
  syncSessions SyncSession[]

  @@map("users")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  url         String
  folderPath  String?  @map("folder_path")
  // faviconUrl  String?  @map("favicon_url")
  description String?
  tags        String[]
  context     String?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  syncedAt    DateTime @default(now()) @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@map("bookmarks")
}

model SyncSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  browserId        String    @map("browser_id")
  sessionStart     DateTime  @default(now()) @map("session_start")
  sessionEnd       DateTime? @map("session_end")
  bookmarksAdded   Int       @default(0) @map("bookmarks_added")
  bookmarksUpdated Int       @default(0) @map("bookmarks_updated")
  bookmarksDeleted Int       @default(0) @map("bookmarks_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sync_sessions")
}
